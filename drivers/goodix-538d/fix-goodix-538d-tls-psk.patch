+static void check_preset_psk_read(FpDevice* dev, gboolean success,
+                                  guint32 flags, guint8* psk, guint16 length,
+                                  gpointer user_data, GError* error)
+{
+    g_autofree gchar* psk_str = data_to_str(psk, length);
+
+    if (error) {
+        fpi_ssm_mark_failed(user_data, error);
+        return;
+    }
+
+    if (success && flags == GOODIX_53XD_PSK_FLAGS &&
+        length == sizeof(goodix_53xd_psk_0) &&
+        memcmp(psk, goodix_53xd_psk_0, sizeof(goodix_53xd_psk_0)) == 0) {
+        fp_dbg("Device PSK matches expected all-zeros PMK hash");
+        fpi_ssm_jump_to_state(user_data, OPEN_RESET);
+        return;
+    }
+
+    fp_warn("Device PSK mismatch (success=%d, flags=0x%08x, len=%u, psk=0x%s); "
+            "provisioning Linux TLS-PSK whitebox",
+            success, flags, length, psk_str ? psk_str : "");
+    fpi_ssm_next_state(user_data);
+}
+
+static void on_write_psk_wrapped(FpDevice* dev, gboolean success,
+                                 gpointer user_data, GError* error)
+{
+    if (error) {
+        fp_warn("Wrapped PSK write returned error (%s), trying raw TLV format",
+                error->message);
+        g_clear_error(&error);
+        fpi_ssm_jump_to_state(user_data, OPEN_WRITE_PSK_RAW);
+        return;
+    }
+    if (!success) {
+        fp_warn("Wrapped PSK write reported failure, trying raw TLV format");
+        fpi_ssm_jump_to_state(user_data, OPEN_WRITE_PSK_RAW);
+        return;
+    }
+    fp_info("Wrapped PSK write succeeded, verifying PSK hash");
+    fpi_ssm_next_state(user_data);
+}
+
+static void verify_psk_wrapped_cb(FpDevice* dev, gboolean success,
+                                  guint32 flags, guint8* psk, guint16 length,
+                                  gpointer user_data, GError* error)
+{
+    g_autofree gchar* psk_str = data_to_str(psk, length);
+
+    if (error) {
+        fp_warn("PSK read after wrapped write failed (%s), trying raw TLV format",
+                error->message);
+        g_clear_error(&error);
+        fpi_ssm_jump_to_state(user_data, OPEN_WRITE_PSK_RAW);
+        return;
+    }
+
+    if (success && flags == GOODIX_53XD_PSK_FLAGS &&
+        length == sizeof(goodix_53xd_psk_0) &&
+        memcmp(psk, goodix_53xd_psk_0, sizeof(goodix_53xd_psk_0)) == 0) {
+        fp_info("Device PSK successfully provisioned (wrapped 53xd format)");
+        fpi_ssm_jump_to_state(user_data, OPEN_RESET);
+        return;
+    }
+
+    fp_warn("PSK still mismatched after wrapped write (0x%s), trying raw TLV format",
+            psk_str ? psk_str : "");
+    fpi_ssm_next_state(user_data);
+}
+
+static void on_write_psk_raw(FpDevice* dev, gboolean success,
+                             gpointer user_data, GError* error)
+{
+    if (error) {
+        fpi_ssm_mark_failed(user_data, error);
